# URL pública del sitio, sin barra final. Se usa en canonical, Open Graph,
# datos estructurados, sitemap.xml y robots.txt.
VITE_SITE_URL=https://wodexsystem.com

# Access key de Web3Forms (https://web3forms.com). Es una clave pública por
# diseño: solo identifica el correo de destino y no permite leer mensajes.
# Créala con el correo donde quieres recibir los formularios.
VITE_WEB3FORMS_ACCESS_KEY=
